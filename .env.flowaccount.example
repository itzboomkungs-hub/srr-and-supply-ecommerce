# FlowAccount Client ID / Client Secret ไม่ต้องใส่ในไฟล์นี้
# ให้ใส่ผ่านหน้า หลังบ้าน > ตั้งค่าระบบ > FlowAccount
#
# ค่านี้เป็น Master Key ของเว็บสำหรับเข้ารหัส Secret/Token ใน MySQL
# สร้างอัตโนมัติได้ด้วย:
# node scripts/setup-flowaccount-key.mjs

SRR_SETTINGS_ENCRYPTION_KEY="PUT_32_BYTE_BASE64_KEY_HERE"
